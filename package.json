{
  "name": "@hello.nrfcloud.com/backend",
  "version": "0.0.0-development",
  "description": "Cloud backend for hello.nrfcloud.com developed using AWS CDK in TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --test --test-reporter spec \"!(dist|node_modules)/**/*.spec.ts\"",
    "test:e2e": "node --experimental-transform-types --no-warnings ./feature-runner/run-features.ts > e2e-test-result.json && cat e2e-test-result.json | node --experimental-transform-types --no-warnings ./feature-runner/console-reporter.ts --only-failed --with-timestamps",
    "prepare": "husky && check-node-version --package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/backend.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/backend/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/backend#readme",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud",
    "aws",
    "cdk"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-acm": "3.910.0",
    "@aws-sdk/client-apigatewaymanagementapi": "3.910.0",
    "@aws-sdk/client-cloudformation": "3.910.0",
    "@aws-sdk/client-cloudwatch-logs": "3.910.0",
    "@aws-sdk/client-dynamodb": "3.910.0",
    "@aws-sdk/client-ecr": "3.910.0",
    "@aws-sdk/client-ecs": "3.910.0",
    "@aws-sdk/client-eventbridge": "3.910.0",
    "@aws-sdk/client-iam": "3.910.0",
    "@aws-sdk/client-iot": "3.910.0",
    "@aws-sdk/client-iot-data-plane": "3.910.0",
    "@aws-sdk/client-lambda": "3.910.0",
    "@aws-sdk/client-route-53": "3.910.0",
    "@aws-sdk/client-ses": "3.910.0",
    "@aws-sdk/client-sfn": "3.910.0",
    "@aws-sdk/client-sqs": "3.910.0",
    "@aws-sdk/client-ssm": "3.910.0",
    "@aws-sdk/client-sts": "3.910.0",
    "@aws-sdk/client-timestream-query": "3.910.0",
    "@aws-sdk/client-timestream-write": "3.910.0",
    "@aws-sdk/util-dynamodb": "3.910.0",
    "@bifravst/aws-cdk-ecr-helpers": "1.3.123",
    "@bifravst/aws-cdk-lambda-helpers": "3.5.63",
    "@bifravst/bdd-markdown": "8.2.78",
    "@bifravst/ci": "2.1.1",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/http-api-mock": "2.1.309",
    "@bifravst/prettier-config": "1.1.13",
    "@bifravst/random-words": "8.0.3",
    "@commitlint/config-conventional": "20.0.0",
    "@hello.nrfcloud.com/bdd-markdown-steps": "3.1.48",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.5",
    "@types/aws-lambda": "8.10.156",
    "@types/cfn-response": "1.0.8",
    "@types/glob": "9.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash-es": "4.17.12",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "aws-cdk": "2.1030.0",
    "aws-cdk-lib": "2.220.0",
    "cbor-x": "1.6.0",
    "cdk": "2.1030.0",
    "cfn-response": "1.0.1",
    "chalk": "5.6.2",
    "check-node-version": "4.2.1",
    "commander": "14.0.1",
    "commitlint": "20.1.0",
    "constructs": "10.4.2",
    "glob": "11.0.3",
    "husky": "9.1.7",
    "jsonata": "2.1.0",
    "lint-staged": "16.2.4",
    "nock": "14.0.10",
    "semver": "7.7.3",
    "tsmatchers": "5.0.2",
    "yauzl": "3.2.0",
    "yazl": "3.3.1"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=22.7.0",
    "npm": ">=10"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-lambda-powertools/metrics": "2.27.0",
    "@bifravst/aws-ssm-settings-helpers": "1.2.219",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/run": "1.2.0",
    "@bifravst/timestream-helpers": "6.1.0",
    "@hello.nrfcloud.com/certificate-helpers": "1.0.0",
    "@hello.nrfcloud.com/lambda-helpers": "4.0.11",
    "@hello.nrfcloud.com/nrfcloud-api-helpers": "6.0.375",
    "@hello.nrfcloud.com/proto": "15.4.70",
    "@hello.nrfcloud.com/proto-map": "16.5.19",
    "@middy/core": "6.4.5",
    "@middy/input-output-logger": "6.4.5",
    "@sinclair/typebox": "0.34.41",
    "cbor-x": "1.6.0",
    "e118-iin-list": "4.5.0",
    "id128": "1.6.6",
    "jsonwebtoken": "9.0.2",
    "lodash-es": "4.17.21",
    "mqtt": "5.14.1",
    "p-limit": "7.1.1",
    "p-retry": "7.1.0",
    "semver": "7.7.3",
    "table": "6.9.0",
    "ws": "8.18.3"
  }
}
