{
  "name": "@hello.nrfcloud.com/backend",
  "version": "0.0.0-development",
  "description": "Cloud backend for hello.nrfcloud.com developed using AWS CDK in TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --test --test-reporter spec \"!(dist|node_modules)/**/*.spec.ts\"",
    "test:e2e": "node --experimental-transform-types --no-warnings ./feature-runner/run-features.ts > e2e-test-result.json && cat e2e-test-result.json | node --experimental-transform-types --no-warnings ./feature-runner/console-reporter.ts --only-failed --with-timestamps",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/backend.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/backend/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/backend#readme",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud",
    "aws",
    "cdk"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-acm": "3.1115.0",
    "@aws-sdk/client-apigatewaymanagementapi": "3.1115.0",
    "@aws-sdk/client-cloudformation": "3.1115.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1115.0",
    "@aws-sdk/client-dynamodb": "3.1115.0",
    "@aws-sdk/client-ecr": "3.1115.0",
    "@aws-sdk/client-ecs": "3.1115.0",
    "@aws-sdk/client-eventbridge": "3.1115.0",
    "@aws-sdk/client-iam": "3.1115.0",
    "@aws-sdk/client-iot": "3.1115.0",
    "@aws-sdk/client-iot-data-plane": "3.1115.0",
    "@aws-sdk/client-lambda": "3.1115.0",
    "@aws-sdk/client-route-53": "3.1115.0",
    "@aws-sdk/client-ses": "3.1115.0",
    "@aws-sdk/client-sfn": "3.1115.0",
    "@aws-sdk/client-sqs": "3.1115.0",
    "@aws-sdk/client-ssm": "3.1115.0",
    "@aws-sdk/client-sts": "3.1115.0",
    "@aws-sdk/client-timestream-query": "3.1115.0",
    "@aws-sdk/client-timestream-write": "3.1115.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@bifravst/aws-cdk-ecr-helpers": "2.0.0",
    "@bifravst/aws-cdk-lambda-helpers": "5.0.5",
    "@bifravst/bdd-markdown": "9.0.2",
    "@bifravst/ci": "3.0.1",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.2",
    "@bifravst/http-api-mock": "3.0.22",
    "@bifravst/prettier-config": "2.0.0",
    "@bifravst/random-words": "9.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@hello.nrfcloud.com/bdd-markdown-steps": "5.0.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/aws-lambda": "8.10.162",
    "@types/cfn-response": "1.0.9",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash-es": "4.17.12",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1137.0",
    "aws-cdk-lib": "2.266.0",
    "cbor-x": "1.6.6",
    "cdk": "2.1138.0",
    "cfn-response": "1.0.1",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "commander": "15.0.0",
    "commitlint": "21.2.2",
    "constructs": "10.8.1",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "jsonata": "2.2.2",
    "lint-staged": "17.3.0",
    "nock": "14.0.17",
    "semver": "7.8.5",
    "tsmatchers": "6.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-lambda-powertools/metrics": "2.35.0",
    "@bifravst/aws-ssm-settings-helpers": "2.0.1",
    "@bifravst/from-env": "4.0.0",
    "@bifravst/run": "2.0.1",
    "@bifravst/timestream-helpers": "7.0.0",
    "@hello.nrfcloud.com/certificate-helpers": "1.0.2",
    "@hello.nrfcloud.com/lambda-helpers": "5.0.54",
    "@hello.nrfcloud.com/nrfcloud-api-helpers": "7.0.3",
    "@hello.nrfcloud.com/proto": "16.0.0",
    "@hello.nrfcloud.com/proto-map": "17.1.1",
    "@middy/core": "7.7.4",
    "@middy/input-output-logger": "7.7.4",
    "@sinclair/typebox": "0.34.52",
    "cbor-x": "1.6.6",
    "e118-iin-list": "4.5.1",
    "id128": "1.6.6",
    "jsonwebtoken": "9.0.3",
    "lodash-es": "4.18.1",
    "mqtt": "5.15.2",
    "p-limit": "7.3.1",
    "p-retry": "8.0.0",
    "semver": "7.8.5",
    "table": "6.9.0",
    "ws": "8.21.3"
  }
}
